# Binance API Keys (TESTNET)
# สร้าง Testnet API Key ที่: https://testnet.binancefuture.com/
# คลิก "API Key" (มุมบนขวา) → สร้าง key ได้เลย ไม่ต้องยืนยันตัวตน
BINANCE_API_KEY=your_testnet_api_key_here
BINANCE_API_SECRET=your_testnet_api_secret_here

# ตั้งค่า testnet (true = ทดสอบ, false = เงินจริง)
USE_TESTNET=true
